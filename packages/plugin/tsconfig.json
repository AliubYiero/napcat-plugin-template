{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "outDir": "dist",
        // 类型检查覆盖 src 与 test, 因此根目录取包根 (构建产物由 vite 产出, 不走 tsc)
        "rootDir": "."
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.json",
        "test/**/*.ts",
        "vite.config.ts",
        "vitest.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
