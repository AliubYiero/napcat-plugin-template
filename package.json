{
    "name": "napcat-plugin-template-monorepo",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "build": "pnpm --filter @napcat-plugin-template/webui build && pnpm --filter @napcat-plugin-template/plugin build",
        "deploy": "pnpm --filter @napcat-plugin-template/webui build && pnpm --filter @napcat-plugin-template/plugin deploy",
        "dev": "pnpm --filter @napcat-plugin-template/webui build && pnpm --filter @napcat-plugin-template/plugin dev",
        "dev:webui": "pnpm --filter @napcat-plugin-template/webui dev",
        "test": "pnpm --filter @napcat-plugin-template/plugin test",
        "typecheck": "pnpm -r typecheck",
        "format": "biome format --write"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10"
    }
}
